# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave pubblica "anon" / "publishable": è pensata per stare nel browser.
# La sicurezza dei dati è garantita dalle policy RLS, non da questa chiave.
VITE_SUPABASE_ANON_KEY=
